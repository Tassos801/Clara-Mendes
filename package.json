{
  "name": "clara-mendes",
  "private": true,
  "sideEffects": false,
  "version": "2026.4.0",
  "type": "module",
  "scripts": {
    "build": "shopify hydrogen build --codegen",
    "dev": "shopify hydrogen dev --codegen",
    "preview": "shopify hydrogen preview --build",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "test": "node --test \"scripts/*.node-test.mjs\"",
    "typecheck": "react-router typegen && tsc --noEmit",
    "codegen": "shopify hydrogen codegen && react-router typegen",
    "storefront:purchase-path:audit": "node ./scripts/audit-customer-purchase-path.mjs",
    "catalog:art:audit": "node ./scripts/audit-original-art-catalog.mjs && node ./scripts/audit-art-product-extensions.mjs",
    "catalog:art:dry-run": "node ./scripts/sync-original-art-catalog.mjs",
    "catalog:art:sync": "node ./scripts/sync-original-art-catalog.mjs --apply",
    "catalog:art:sizes:prepare": "python ./scripts/prepare-original-art-size-assets.py",
    "catalog:art:sizes:prepare:bigger": "python ./scripts/prepare-original-art-size-assets.py --size=20x24",
    "catalog:art:sizes:audit": "node ./scripts/sync-original-art-size-variants.mjs",
    "catalog:art:sizes:audit:bigger": "node ./scripts/sync-original-art-size-variants.mjs --size=20x24",
    "catalog:art:sizes:stage": "node ./scripts/sync-original-art-size-variants.mjs --stage",
    "catalog:art:sizes:stage:bigger": "node ./scripts/sync-original-art-size-variants.mjs --size=20x24 --stage",
    "catalog:art:sizes:activate": "node ./scripts/sync-original-art-size-variants.mjs --activate",
    "catalog:art:sizes:activate:bigger": "node ./scripts/sync-original-art-size-variants.mjs --size=20x24 --activate",
    "catalog:art:sizes:pause": "node ./scripts/sync-original-art-size-variants.mjs --pause",
    "catalog:art:sizes:pause:bigger": "node ./scripts/sync-original-art-size-variants.mjs --size=20x24 --pause",
    "catalog:art:mockups": "node ./scripts/generate-room-mockups.mjs",
    "catalog:art:mockups:large": "node ./scripts/generate-room-mockups.mjs --size=16x20",
    "catalog:art:mockups:bigger": "node ./scripts/generate-room-mockups.mjs --size=20x24",
    "catalog:art:mockups:dry-run": "node ./scripts/sync-room-mockups.mjs",
    "catalog:art:mockups:sync": "node ./scripts/sync-room-mockups.mjs --apply",
    "catalog:art:sofa-mockups": "node ./scripts/generate-sofa-mockups.mjs",
    "catalog:art:sofa-mockups:dry-run": "node ./scripts/sync-sofa-mockups.mjs",
    "catalog:art:sofa-mockups:preflight": "node ./scripts/sync-sofa-mockups.mjs --preflight",
    "catalog:art:sofa-mockups:sync": "node ./scripts/sync-sofa-mockups.mjs --apply",
    "catalog:extensions:prepare": "python ./scripts/prepare-art-product-extensions.py",
    "catalog:extensions:validate": "python ./scripts/validate-art-product-files.py",
    "catalog:extensions:dry-run": "node ./scripts/sync-art-product-extensions.mjs",
    "catalog:extensions:sync": "node ./scripts/sync-art-product-extensions.mjs --apply",
    "catalog:extensions:audit": "node ./scripts/audit-art-product-extensions.mjs",
    "catalog:legacy:dry-run": "node ./scripts/unpublish-all-products.mjs --dry-run",
    "catalog:legacy:draft": "node ./scripts/unpublish-all-products.mjs",
    "catalog:legacy:restore": "node ./scripts/unpublish-all-products.mjs --restore",
    "clean": "node ./scripts/clean.mjs",
    "clean:deps": "node ./scripts/clean.mjs --deps"
  },
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@shopify/hydrogen": "2026.4.4",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "gsap": "^3.15.0",
    "isbot": "^5.1.22",
    "lenis": "^1.3.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.1",
    "react-router-dom": "7.18.1",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@graphql-codegen/cli": "5.0.2",
    "@react-router/dev": "7.18.1",
    "@react-router/fs-routes": "7.18.1",
    "@shopify/cli": "3.91.1",
    "@shopify/hydrogen-codegen": "0.3.3",
    "@shopify/mini-oxygen": "4.2.0",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@shopify/prettier-config": "^1.1.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^9.6.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.184.1",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "graphql-config": "^5.0.3",
    "prettier": "^3.4.2",
    "sharp": "0.35.3",
    "typescript": "^5.9.2",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^4.3.1"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "overrides": {
    "lodash": "4.18.1",
    "react-router": "$react-router",
    "react-router-dom": "$react-router-dom",
    "@react-router/dev": "$@react-router/dev"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2"
  }
}
